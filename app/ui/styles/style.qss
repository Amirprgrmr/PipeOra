/* ============================================================== */
/*           AM Audio Control - Graphite Dark QSS Stylesheet      */
/* ============================================================== */

/* پنجره و پس‌زمینه کلی */
QMainWindow, QDialog, QWidget#centralWidget {
    background-color: #111318;
    color: #F2F4F8;
    font-family: "Vazirmatn", "Noto Sans Arabic", "Segoe UI", sans-serif;
    font-size: 13px;
}

/* کارت‌ها و کانتینرها */
QFrame[card="true"], .card {
    background-color: #191E27;
    border: 1px solid #2D3545;
    border-radius: 12px;
    padding: 16px;
}

QFrame[card="true"]:hover {
    border-color: #3B4559;
}

/* پنل نوار کناری (Sidebar) */
#sidebar {
    background-color: #151921;
    border-left: 1px solid #2D3545; /* در RTL، حاشیه چپ به سمت محتوا قرار می‌گیرد */
    min-width: 220px;
    max-width: 250px;
}

/* دکمه‌های ناوبری نوار کناری */
QPushButton[nav="true"] {
    background-color: transparent;
    color: #A6AFBD;
    border: none;
    border-radius: 8px;
    padding: 12px 16px;
    text-align: right;
    font-size: 13px;
    font-weight: 500;
}

QPushButton[nav="true"]:hover {
    background-color: #222936;
    color: #F2F4F8;
}

QPushButton[nav="true"][active="true"] {
    background-color: rgba(103, 201, 243, 0.12);
    color: #67C9F3;
    font-weight: 600;
    border-right: 3px solid #67C9F3;
}

/* دکمه‌های عمومی */
QPushButton {
    background-color: #222936;
    color: #F2F4F8;
    border: 1px solid #2D3545;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #2B3342;
    border-color: #3B4559;
}

QPushButton:pressed {
    background-color: #191E27;
}

QPushButton:disabled {
    background-color: #161A22;
    color: #6B7687;
    border-color: #202633;
}

/* دکمه‌های اصلی (Primary Button) */
QPushButton[primary="true"] {
    background-color: #67C9F3;
    color: #111318;
    border: none;
    font-weight: bold;
}

QPushButton[primary="true"]:hover {
    background-color: #85D5F6;
}

QPushButton[primary="true"]:pressed {
    background-color: #4DBEEF;
}

/* دکمه‌های موفقیت (Success Button) */
QPushButton[success="true"] {
    background-color: #55CFA0;
    color: #111318;
    border: none;
    font-weight: bold;
}

QPushButton[success="true"]:hover {
    background-color: #6FE0B4;
}

/* دکمه‌های خطر / قطع اتصال (Danger Button) */
QPushButton[danger="true"] {
    background-color: rgba(235, 119, 119, 0.15);
    color: #EB7777;
    border: 1px solid rgba(235, 119, 119, 0.4);
}

QPushButton[danger="true"]:hover {
    background-color: rgba(235, 119, 119, 0.25);
    border-color: #EB7777;
}

/* دکمه‌های آیکونی فشرده */
QPushButton[icon_btn="true"] {
    padding: 6px;
    border-radius: 6px;
}

/* کنترل اسلایدر صدا (Audio Slider) */
QSlider::groove:horizontal {
    height: 8px;
    background-color: #222936;
    border-radius: 4px;
}

QSlider::sub-page:horizontal {
    background-color: #67C9F3;
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background-color: #FFFFFF;
    border: 3px solid #67C9F3;
    width: 18px;
    height: 18px;
    margin: -5px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background-color: #F2F4F8;
    border-color: #85D5F6;
    width: 20px;
    height: 20px;
    margin: -6px 0;
    border-radius: 10px;
}

QSlider::handle:horizontal:disabled {
    background-color: #6B7687;
    border-color: #434D5D;
}

/* اسکرول بار مدرن و باریک */
QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 0;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #2D3545;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #3B4559;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

/* چک‌باکس و سوییچ‌ها */
QCheckBox {
    color: #F2F4F8;
    spacing: 10px;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 1px solid #2D3545;
    border-radius: 6px;
    background-color: #191E27;
}

QCheckBox::indicator:hover {
    border-color: #67C9F3;
}

QCheckBox::indicator:checked {
    background-color: #67C9F3;
    border-color: #67C9F3;
}

/* کمبوباکس */
QComboBox {
    background-color: #222936;
    color: #F2F4F8;
    border: 1px solid #2D3545;
    border-radius: 8px;
    padding: 8px 12px;
}

QComboBox:hover {
    border-color: #3B4559;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #191E27;
    color: #F2F4F8;
    border: 1px solid #2D3545;
    selection-background-color: #222936;
    selection-color: #67C9F3;
    border-radius: 8px;
    padding: 4px;
}

/* راهنماها (Tooltips) */
QToolTip {
    background-color: #191E27;
    color: #F2F4F8;
    border: 1px solid #67C9F3;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 11px;
}

/* عناوین و برچسب‌ها */
QLabel#pageTitle {
    font-size: 20px;
    font-weight: bold;
    color: #F2F4F8;
}

QLabel#sectionTitle {
    font-size: 15px;
    font-weight: 600;
    color: #F2F4F8;
}

QLabel#mutedText {
    color: #A6AFBD;
    font-size: 12px;
}
